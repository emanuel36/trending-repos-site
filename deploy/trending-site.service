[Unit]
Description=Build the daily trending GitHub repos page
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trending
WorkingDirectory=/opt/trending-site
EnvironmentFile=/etc/trending-site/env
ExecStart=/usr/bin/python3 -m trending_site run
StateDirectory=trending-site
ReadWritePaths=/srv/trending-site
UMask=0022
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
